+//   • pushUndo: no re-stringify of the stack top per grab + a global snapshot budget
+//   • bounded fetch caches (_tcCachePut) evict oldest-first
+//   • player-search haystacks precomputed at index build
+// ═══════════════════════════════════════════════════════════════════════════
+
+const elStore={};

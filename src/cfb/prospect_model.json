{
 "_doc": {
  "what": "Frozen artifacts for the pre-NFL fantasy-relevance model. Scored at SEED BUILD time (src/cfb/combine.py score()); the app only renders the baked numbers.",
  "training": "All drafted QB/RB/WR/TE 2000-2022 (nflverse draft_picks + combine + player_stats). Label: a top-12 (QB/TE) / top-24 (RB/WR) PPR season within the player's first 3 NFL years.",
  "per_position_keys": {
   "features": "Input order. *_m are missing-flags (1 = that input was absent; skipping a drill was itself a signal in training).",
   "median": "Training-cohort median used to fill a missing input (with its flag set).",
   "mu_sd": "Standardizer: z = (x - mu[i]) / sd[i], same order as features.",
   "coef_intercept": "Logistic weights on the standardized inputs: z-sum + intercept -> sigmoid -> raw probability. THESE ARE THE WEIGHTS - a coef's sign/size is that feature's pull (log_pick negative = later pick, lower odds).",
   "iso": "Isotonic calibration knots [raw_prob, calibrated_prob]: the raw sigmoid is piecewise-linearly mapped through these so 40% means 40%. If you change coef, calibration is no longer guaranteed - percentages become a score, not a probability.",
   "n_base_rate": "Cohort size and hit rate, for context.",
   "pctl": "51 quantiles of the training cohort's calibrated probabilities. The app maps a player's prob onto these to show a PERCENTILE vs two decades of drafted players \u2014 the display number. prob stays the honest calibrated hit chance."
  },
  "feature_glossary": {
   "log_pick": "log2(overall draft pick), clipped 1-300. Undrafted scores as pick 263.",
   "age": "Age at draft (nflverse draft_picks).",
   "speed_score": "weight * 200 / forty^4 (weight-adjusted 40).",
   "burst": "vertical + broad jump (inches).",
   "f_succ": "QB: college success rate, final season (share of plays with positive EPA).",
   "f_comp_pct": "QB: college completion %, final season.",
   "f_yptpa": "TE: receiving yards per TEAM pass attempt, final season.",
   "dom_teamadj": "TE: dominator rating x (1 + 0.5 x teammate draft capital) \u2014 dominating on a loaded roster counts extra. The 2026-08-27 study found this the best college metric at RB/WR/TE."
  },
  "tweak_workflow": "Edit this file -> python3 tools/prospect_rescore.py (re-scores every profile in seeds/triplecrown_seed.json + regenerates the .gz) -> python3 bake_seed.py --seed seeds/triplecrown_seed.json --out index_ui_preview.html to see it. CI refresh re-scores the same way via the cfb source.",
  "retrain": "To actually retrain (new features/labels/cohort) see the analysis pipeline in the 2026-08-27 prospect study (scratchpad/prospect: analyze.py, finalize.py, weights_analysis.py) - finalize.py writes this file.",
  "v2_note": "QB/TE retrained 2016-2022 WITH college signals (study: +0.03-0.06 CV-AUC). RB/WR deliberately stay draft+athletics only \u2014 the study showed college production is already priced into their draft capital."
 },

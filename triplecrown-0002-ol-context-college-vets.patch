+def _block(draft_class, ref):
+    return {"schema": SCHEMA, "class": int(draft_class),
+            "reference": {"classes": ref.get("classes"), "steps": ref.get("steps")},
+            "labels": LABELS, "headline": HEADLINE, "players": {}}

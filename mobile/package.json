{
  "name": "triplecrown-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "The TripleCrown app as a native shell for Android and iOS (Capacitor).",
  "scripts": {
    "sync": "cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "apk": "cd android && ./gradlew assembleDebug && ls -la app/build/outputs/apk/debug/",
    "aab": "cd android && ./gradlew bundleRelease && ls -la app/build/outputs/bundle/release/"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  }
}
